{
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "oscar-portfolio",
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	}
}