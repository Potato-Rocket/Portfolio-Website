---
import type { CollectionEntry } from "astro:content";

import Tag from "./Tag.astro";
import { formatDateRange } from "../lib/dates";
import ProjectThumbnail from "./ProjectThumbnail.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, tags, status, periods } = project.data;
const isWip = status === "wip";
const dateLabel = formatDateRange(periods, status === "ongoing");
---

<a href={`/projects/${project.id}`} class="group flex flex-col gap-4 sm:flex-row sm:flex-wrap">
  {/* self-start: in mobile flex-col, default align-self is stretch, which would fill the
      container width and override aspect-video (browsers ignore aspect-ratio when both width
      and height are set). self-start keeps the thumbnail at its intrinsic aspect-video size. */}
  <ProjectThumbnail slug={project.id} title={title} class="h-32 shrink-0 self-start" />
  {/* max-w-104 applies at every tier so the text block doesn't bulge wider at xs (where the
      entry col can exceed 416px) than it will at sm+. flex-1 and min-w only kick in at sm where
      the entry can sit side-by-side with the thumbnail. */}
  <div class="max-w-104 sm:flex-1 sm:min-w-[18rem]">
    <h2 class="text-xl group-hover:underline underline-offset-2">
      {title}
      {isWip ? <span class="font-light font-sans">· WIP</span> : null}
    </h2>
    <p class="text-ink-muted text-sm">{dateLabel}</p>
    <div class="py-1">
      {tags.map((tag) => (
          <Tag tagName={tag}/>
      ))}
    </div>
    <p>{summary}</p>
  </div>
</a>
