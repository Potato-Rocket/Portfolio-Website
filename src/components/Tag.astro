---
import tagColors from "../data/tag-colors.json";

interface Props {
    tagName: string
}

const { tagName } = Astro.props;
const hue = (tagColors as unknown as Record<string, number>)[tagName] ?? 35;
---

<p class="tag font-thin text-xs border py-0.5 px-1 w-fit inline-flex mr-1" style={`--hue: ${hue}`}>
    {tagName.toUpperCase()}
</p>

<style>
    .tag {
        --hue: 35;
        background: oklch(88% 0.07 var(--hue));
        border-color: oklch(62% 0.14 var(--hue));
        color: oklch(22% 0.02 var(--hue));
    }
    :global(.dark) .tag {
        background: oklch(28% 0.07 var(--hue));
        border-color: oklch(55% 0.14 var(--hue));
        color: oklch(90% 0.02 var(--hue));
    }
</style>