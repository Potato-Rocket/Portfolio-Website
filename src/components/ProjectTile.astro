---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  size: "large" | "medium" | "small";
}

const { project, size } = Astro.props;
const { title, summary, status, tags, thumbnail } = project.data;
const isWip = status === "wip";
---

<a
  href={`/projects/${project.id}`}
  class:list={[
    "group flex flex-col rounded-lg overflow-hidden h-full",
    "border border-border bg-surface transition-shadow hover:shadow-md",
    isWip ? "border-dashed" : "border-solid",
  ]}
  data-tags={tags.join(",")}
>
  {thumbnail && (
    <div class="aspect-video overflow-hidden shrink-0">
      <img
        src={thumbnail}
        alt=""
        class="w-full h-full object-cover transition-transform group-hover:scale-[1.02]"
      />
    </div>
  )}

  <div class="flex flex-col gap-3 p-4 grow">
    <div class="flex items-start justify-between gap-3">
      <h2 class:list={[
        "font-semibold leading-snug",
        size === "large" ? "text-xl" : "text-base",
      ]}>
        {title}
      </h2>
      {isWip && (
        <span class="text-xs font-sans font-medium px-2 py-0.5 rounded-full shrink-0 mt-0.5 bg-border text-muted">
          WIP
        </span>
      )}
    </div>

    {size !== "small" && (
      <p class="text-sm leading-relaxed grow text-muted">{summary}</p>
    )}

    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-border text-muted">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>