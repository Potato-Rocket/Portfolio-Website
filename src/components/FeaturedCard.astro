---
import type { CollectionEntry } from "astro:content";

import Tag from "./Tag.astro";
import { formatDateRange } from "../lib/dates";
import { thumbnailPath } from "../lib/thumbnails";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className = "" } = Astro.props;
const { title, summary, tags, status, startDate, endDate } = project.data;
const isWip = status === "wip";
const dateLabel = formatDateRange(startDate, endDate, status === "ongoing");
---

<a href={`/projects/${project.id}`} class:list={["block group", className]}>
  <div class="flex items-baseline justify-between pl-1 pb-3">
    <h2 class="text-xl">
      {title}
      {isWip ? <span class="font-light font-sans">· WIP</span> : null}
    </h2>
  </div>
  <div class:list={["border border-rule group-hover:border-rule-strong transition-colors bg-paper-deep p-4", { "border-dashed": isWip }]}>
    <div class="aspect-video border border-rule-strong overflow-hidden">
      <img
          src={thumbnailPath(project.id)}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    </div>
    <p class="my-3">{summary}</p>
    <p class="text-ink-muted text-sm my-3">{dateLabel}</p>
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <Tag tagName={tag}/>
      ))}
    </div>
  </div>
</a>