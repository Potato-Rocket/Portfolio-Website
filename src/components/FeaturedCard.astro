---
import type { CollectionEntry } from "astro:content";

import { formatDateRange } from "../lib/dates";
import ProjectThumbnail from "./ProjectThumbnail.astro";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
}

const { project, class: className = "" } = Astro.props;
const { title, summary, status, periods, demo } = project.data;
const isWip = status === "wip";
const dateLabel = formatDateRange(periods, status === "ongoing");
const demoHref = demo ? `/projects/${project.id}#demo` : undefined;
---

<div class:list={["group relative", className]}>
  <div class="flex items-baseline justify-between pl-1 pb-3">
    <h2 class="text-xl">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
      {isWip ? <span class="font-light font-sans">· WIP</span> : null}
    </h2>
  </div>
  <div class:list={["border border-rule group-hover:border-rule-strong transition-colors p-4", { "border-dashed": isWip }]}>
    <ProjectThumbnail slug={project.id} title={title} loading="eager" demoHref={demoHref} />
    <p class="mt-3 text-lg italic text-ink-muted">{summary}</p>
    <p class="text-ink-muted text-sm mt-3">{dateLabel}</p>
  </div>
</div>