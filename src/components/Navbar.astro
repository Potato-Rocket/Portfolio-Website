---
interface Props {
  tab: "projects" | "gallery";
  projectTitle?: string;
  isWip?: boolean;
}

const { tab, projectTitle, isWip = false } = Astro.props;
const isProjectDetail = tab === "projects" && !!projectTitle;

const linkClass = "text-3xl font-serif hover:underline underline-offset-4 decoration-1";
const activeClass = "text-3xl font-serif font-bold";
---

<header class="sticky top-0 z-10 border-b border-rule py-4 bg-paper">
  {/*
    sm+ all pages use the 3-col grid (1fr auto 1fr): icon (justify-end), Projects-or-title
    (center), Gallery (justify-start). Gallery's column is stable across pages so it doesn't
    swap sides when active vs inactive — only its bold/active styling changes. The center
    column trades between "Projects" (link or active) and the project title on detail pages.
    Below sm:
    - Non-detail wraps as a centered flex row — at very narrow widths icon/Projects/Gallery
      can't share a line and Gallery flows underneath, still centered.
    - Detail stacks three rows: icon+breadcrumb left, title (centered <xs, left xs+), Gallery
      centered on its own row below the title.
  */}
  <nav class:list={[
    "max-w-6xl mx-auto px-4 sm:px-12",
    "sm:grid sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:gap-6",
    isProjectDetail
      ? "flex flex-col gap-2"
      : "flex flex-wrap justify-center items-center gap-x-6 gap-y-2",
  ]}>
    <div class:list={[
      "flex items-center gap-6",
      isProjectDetail ? "justify-start sm:justify-end" : "sm:justify-end",
    ]}>
      <a href="/" class={linkClass} transition:name="nav-brand">Home</a>
      {isProjectDetail && (
        <>
          <a href="/projects" class={linkClass} transition:name="nav-projects">Projects</a>
          <span class="text-3xl font-serif text-ink-muted" aria-hidden="true">/</span>
        </>
      )}
    </div>

    <div class:list={[
      "flex items-center",
      // <xs: center (title likely wraps; centered reads better when wrapped).
      // xs+ stacked: left-align under the breadcrumb (title fits on one line at this width).
      // sm+ grid: surrounding 1fr cells center the auto column, so inner align is moot.
      isProjectDetail ? "justify-center text-center xs:justify-start xs:text-left" : "",
    ]}>
      {isProjectDetail ? (
        <span class={activeClass} aria-current="page">
          {projectTitle}
          {isWip && <span class="font-light font-sans"> · WIP</span>}
        </span>
      ) : tab === "projects" ? (
        <span class={activeClass} aria-current="page" transition:name="nav-projects">Projects</span>
      ) : (
        <a href="/projects" class={linkClass} transition:name="nav-projects">Projects</a>
      )}
    </div>

    <div class:list={[
      "flex items-center",
      // Stacked detail centers Gallery on its own row; sm+ grid pins it to col 3's left edge.
      isProjectDetail ? "justify-center sm:justify-start" : "sm:justify-start",
    ]}>
      {tab === "gallery" ? (
        <span class={activeClass} aria-current="page" transition:name="nav-gallery">Gallery</span>
      ) : (
        <a href="/gallery" class={linkClass} transition:name="nav-gallery">Gallery</a>
      )}
    </div>
  </nav>
</header>

<style is:global>
  ::view-transition-group(nav-brand),
  ::view-transition-group(nav-projects),
  ::view-transition-group(nav-gallery) {
    animation-duration: 400ms;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  ::view-transition-old(nav-brand),
  ::view-transition-new(nav-brand),
  ::view-transition-old(nav-projects),
  ::view-transition-new(nav-projects),
  ::view-transition-old(nav-gallery),
  ::view-transition-new(nav-gallery) {
    animation-duration: 150ms;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(nav-brand),
    ::view-transition-group(nav-projects),
    ::view-transition-group(nav-gallery),
    ::view-transition-old(nav-brand),
    ::view-transition-new(nav-brand),
    ::view-transition-old(nav-projects),
    ::view-transition-new(nav-projects),
    ::view-transition-old(nav-gallery),
    ::view-transition-new(nav-gallery) {
      animation: none;
    }
  }
</style>