---
import { Icon } from "astro-icon/components";

interface Props {
  links?: { github?: string; live?: string };
  class?: string;
}

const { links, class: className = "" } = Astro.props;
const linkClass = "inline-flex items-center gap-1 hover:underline underline-offset-2";
---

{(links?.github || links?.live) && (
  <div class:list={["flex items-center gap-4", className]}>
    {links?.github && (
      <a href={links.github} class={linkClass} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:github" class="w-4 h-4" />
        GitHub
      </a>
    )}
    {links?.live && (
      <a href={links.live} class={linkClass} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:external-link" class="w-4 h-4" />
        Live
      </a>
    )}
  </div>
)}