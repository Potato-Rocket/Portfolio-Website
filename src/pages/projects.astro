---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ProjectsTimeline from "../components/ProjectsTimeline.svelte";
import { effectiveDate, formatDateRange } from "../lib/dates";
import { findThumbnailPath } from "../lib/thumbnails";

const projects = await getCollection("projects", ({ data }) => !data.hidden);
const sorted = [...projects]
  .sort((a, b) => effectiveDate(a.data.periods).getTime() - effectiveDate(b.data.periods).getTime())
  .reverse();

const projectData = sorted.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  tags: p.data.tags,
  status: p.data.status,
  dateLabel: formatDateRange(p.data.periods, p.data.status === "ongoing"),
  year: effectiveDate(p.data.periods).getUTCFullYear(),
  thumbPath: findThumbnailPath(p.id),
}));
---

<Layout title="Projects" description="All of Oscar's projects — robotics, software, hardware, and more.">
  <Navbar tab="projects" />
  <ProjectsTimeline client:load projects={projectData} />
</Layout>
