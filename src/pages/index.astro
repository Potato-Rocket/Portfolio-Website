---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FeaturedCard from "../components/FeaturedCard.astro";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const featured = projects.filter((p) => p.data.featured);
---

<Layout>
  <div class="max-w-6xl mx-auto px-12 py-8">
    <div class="text-center">
      <!--I want to make it stretched but that's not working-->
      <h1 class="text-5xl">Oscar Stomberg</h1>
      <p class="text-ink-muted max-w-2xl text-lg italic p-8 mx-auto">
        Robotics engineering student at Worcester Polytechnic Institute. From mechanical design and embedded systems, to
        network management and full-stack software development.
      </p>
    </div>
    <!--Need to make adaptive-->
    <div class="grid grid-cols-3 gap-2">
      {featured.map((project) => (
        <div>
          <FeaturedCard project={project} />
        </div>
      ))}
    </div>
    <!--This guy is not centered like is should be, nor is the padding working. Probably the above div's fault-->
    <!--Also want to add an actual arrow here?-->
    <a
        href="/projects"
        class="text-center mx-auto underline underline-offset-2 text-ink-muted text-2xl font-serif py-16"
    >
      See more Projects
    </a>
  </div>
</Layout>