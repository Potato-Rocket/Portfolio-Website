---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
projects.sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => a.data.priority - b.data.priority);
---

<Layout>
  <h1>Oscar's Portfolio</h1>
  <ul>
    {projects.map((project: CollectionEntry<"projects">) => (
      <li>
        <a href={`/projects/${project.id}`}>{project.data.title}</a>
        — {project.data.summary}
      </li>
    ))}
  </ul>
</Layout>
