---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Tag from "../../components/Tag.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import { formatDateRange } from "../../lib/dates";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props as Props;
const { title, summary, status, tags, thumbnail, links, startDate, endDate } = project.data;
const { Content } = await render(project);

const isWip = status === "wip";
const dateLabel = formatDateRange(startDate, endDate, status === "ongoing");
---

<Layout title={title}>
  <Navbar tab="projects" projectTitle={title} />
  <main class="max-w-3xl mx-auto px-6 sm:px-12 py-12">
    <article class="prose prose-paper max-w-none">
      <header class="not-prose mb-10 pb-8 border-b border-rule">
        <h1 class="sr-only">{title}</h1>
        {thumbnail && (
          <div class:list={[
            "aspect-video border border-rule-strong overflow-hidden mb-4",
            { "border-dashed": isWip },
          ]}>
            <img src={thumbnail} alt={title} class="w-full h-full object-cover" />
          </div>
        )}
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 text-sm text-ink-muted">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
            <span>
              {dateLabel}{isWip && <span class="font-light"> · WIP</span>}
            </span>
            {tags.length > 0 && (
              <div class="flex flex-wrap gap-1">
                {tags.map((tag) => <Tag tagName={tag} />)}
              </div>
            )}
          </div>
          <ProjectLinks links={links} />
        </div>
        <p class="mt-6 text-lg italic text-ink-muted">{summary}</p>
      </header>
      <Content />
    </article>
  </main>
</Layout>