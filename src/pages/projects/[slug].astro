---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Tag from "../../components/Tag.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import { formatDateRange, monthYear } from "../../lib/dates";
import { thumbnailPath } from "../../lib/thumbnails";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props as Props;
const { title, summary, status, tags, links, periods } = project.data;
const { Content } = await render(project);

const isWip = status === "wip";
const dateLabel = formatDateRange(periods, status === "ongoing");
const showHistory = periods.length > 1;
---

<Layout title={title}>
  <Navbar tab="projects" projectTitle={title} isWip={isWip} />
  <main class="max-w-3xl mx-auto px-6 sm:px-12 py-12">
    <article class="prose prose-paper max-w-none">
      <header class="not-prose mb-10 pb-8 border-b border-rule">
        <h1 class="sr-only">{title}{isWip ? " (work in progress)" : ""}</h1>
        <div class:list={[
          "aspect-video border border-rule-strong overflow-hidden mb-4",
          { "border-dashed": isWip },
        ]}>
          <img src={thumbnailPath(project.id)} alt={title} class="w-full h-full object-cover" />
        </div>
        {showHistory ? (
          <ul class="text-sm text-ink-muted mb-3 space-y-0.5">
            {periods.map((p) => (
              <li>
                <span>{monthYear(p.date)}</span>
                {p.label && <span class="text-ink"> · {p.label}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-muted mb-3">{dateLabel}</p>
        )}
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3 text-sm text-ink-muted">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-1">
              {tags.map((tag) => <Tag tagName={tag} />)}
            </div>
          )}
          <ProjectLinks links={links} class="ml-auto" />
        </div>
        <p class="mt-6 text-lg italic text-ink-muted">{summary}</p>
      </header>
      <Content />
    </article>
  </main>
</Layout>