---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import TagPill from "../../components/TagPill.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import RelatedCard from "../../components/RelatedCard.astro";
import { formatDateRange, monthYear } from "../../lib/dates";
import ProjectThumbnail from "../../components/ProjectThumbnail.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props as Props;
const { title, summary, status, tags, links, periods } = project.data;
const { Content } = await render(project);

const allProjects = await getCollection("projects");
const relatedEntries = (project.data.related ?? [])
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p): p is CollectionEntry<"projects"> => p !== undefined);

const isWip = status === "wip";
const dateLabel = formatDateRange(periods, status === "ongoing");
const showHistory = periods.length > 1;
---

<Layout title={title}>
  <Navbar tab="projects" projectTitle={title} isWip={isWip} />
  <main class="max-w-3xl mx-auto px-6 sm:px-12 py-12">
    <article class="prose prose-paper max-w-none">
      <header class="not-prose mb-10 pb-8 border-b border-rule">
        <h1 class="sr-only">{title}{isWip ? " (work in progress)" : ""}</h1>
        <ProjectThumbnail slug={project.id} title={title} class="mb-4" />
        {showHistory ? (
          <ul class="text-sm text-ink-muted mb-3 space-y-0.5">
            {periods.map((p) => (
              <li>
                <span>{monthYear(p.date)}</span>
                {p.label && <span class="text-ink"> · {p.label}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-ink-muted mb-3">{dateLabel}</p>
        )}
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3 text-sm text-ink-muted">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-1">
              {tags.map((tag) => <TagPill tag={tag} href={`/projects?tags=${encodeURIComponent(tag)}`} />)}
            </div>
          )}
          <ProjectLinks links={links} class="ml-auto" />
        </div>
        <p class="mt-6 text-lg italic text-ink-muted">{summary}</p>
      </header>
      <Content />
    </article>
    {relatedEntries.length > 0 && (
      <section class="mt-12 pt-8 border-t border-rule not-prose">
        <h2 class="text-sm text-ink-muted mb-6">Related</h2>
        <div class="flex flex-wrap gap-6">
          {relatedEntries.map((r) => (
            <RelatedCard project={r} class="w-56 max-w-full" />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>